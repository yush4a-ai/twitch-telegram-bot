{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.12.10"
  },
  "steps": {
    "preview-tools": {
      "commands": [
        {
          "image": "mwader/static-ffmpeg:9.0.1@sha256:54e55b0cb8f672870fc38ceb2e6c411855cb3b39c505f5f3b2505ee01ed5f2b7",
          "src": "/ffmpeg",
          "dest": "/app/.preview-bin/ffmpeg"
        },
        {
          "image": "mwader/static-ffmpeg:9.0.1@sha256:54e55b0cb8f672870fc38ceb2e6c411855cb3b39c505f5f3b2505ee01ed5f2b7",
          "src": "/ffprobe",
          "dest": "/app/.preview-bin/ffprobe"
        }
      ],
      "deployOutputs": [
        {
          "include": [
            "/app/.preview-bin"
          ]
        }
      ]
    }
  },
  "deploy": {
    "paths": [
      "...",
      "/app/.preview-bin"
    ]
  }
}
