TELEGRAM_BOT_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Как часто опрашивать Twitch API (секунды)
POLL_INTERVAL_SECONDS=60
# Fernet-ключ для шифрования Twitch access/refresh-токенов в SQLite.
# Локально опционален; на Railway обязателен и должен храниться как secret variable.
# Создать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Публичный адрес, на который Twitch редиректит после /auth_twitch.
# Локально можно не задавать (используется http://localhost:8765).
# На Railway — https://<project>.up.railway.app (без path и слэша на конце).
# Если не задан, код берёт https://$RAILWAY_PUBLIC_DOMAIN; без обоих startup падает.
# PUBLIC_URL=

# Порт для встроенного OAuth callback-сервера. На Railway обычно подставляется
# автоматически через переменную PORT — отдельно указывать не нужно.
# PORT=8765

# Путь к файлу БД. На Railway обязателен абсолютный путь внутри Volume,
# например /data/bot.db при Volume mount /data.
# DB_PATH=bot.db

# chat_id владельца бота — тот же, что показывает команда /myid в личке с ботом.
# Даёт доступ к команде /stats (статистика по пользователям) и алертам об ошибках.
# OWNER_CHAT_ID=

# Запасной способ завести подписку, когда до меню бота не добраться.
# Формат: <chat_id>:<twitch_логин>, через запятую можно несколько.
# Повторный старт дубликатов не создаёт, переменную можно оставить насовсем.
# AUTO_TRACK=-1001234567890:bratishkinoff

# Опциональная секретная соль для стабильных псевдонимов chat_id в логах.
# Если не задана, используется TELEGRAM_BOT_TOKEN; сами chat_id в лог не попадают.
# LOG_SALT=
