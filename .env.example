TELEGRAM_BOT_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Как часто опрашивать Twitch API (секунды)
POLL_INTERVAL_SECONDS=60

# Публичный адрес, на который Twitch редиректит после /auth_twitch.
# Локально можно не задавать (используется http://localhost:8765).
# На Railway — https://<project>.up.railway.app (без слэша на конце).
# PUBLIC_URL=

# Порт для встроенного OAuth callback-сервера. На Railway обычно подставляется
# автоматически через переменную PORT — отдельно указывать не нужно.
# PORT=8765

# Путь к файлу БД. На Railway укажите путь внутри примонтированного Volume,
# например /data/bot.db — иначе база будет пересоздаваться при каждом деплое.
# DB_PATH=bot.db
